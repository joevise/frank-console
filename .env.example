# ============================================
# Frank Console 环境变量配置
# 复制为 .env 并填入真实值
# ============================================

# 数据库密码
POSTGRES_PASSWORD=change_me_strong_password

# 端口（避免和 67.209 上已有服务冲突：
# link2context 3000/8000/8001, InKnowing 3001/8002,
# Brand2Context 3002/8004/8005, Social API 8006, AI Embryo 8010）
BACKEND_PORT=8100
FRONTEND_PORT=8180

# JWT 密钥（务必改成随机字符串）
JWT_SECRET=change_me_to_random_secret_string

# ---- Frank 大脑 — OpenMind ----
OPENMIND_API_URL=https://openmind-admin.futurx.cc
OPENMIND_MIND_ID=019f1d4e-3ef0-747b-a188-47fae1ee218e
OPENMIND_API_KEY=your_openmind_jwt_token

# ---- Frank 大脑（LLM 备用，OpenMind 不可用时降级）----
FRANK_LLM_API_KEY=sk-or-your-openrouter-key
FRANK_PRIMARY_MODEL=xiaomi/mimo-v2.5
FRANK_FALLBACK_MODEL=deepseek/deepseek-v4-flash

# ---- dsa_researcher MCP Server ----
DSA_MCP_PORT=8110

# ---- dsa_researcher 顾问层（复用同一个 OpenRouter key）----
DSA_OPENROUTER_KEY=sk-or-your-openrouter-key
DSA_TUSHARE_TOKEN=1f2efb…0b26

# ---- DSA Agent（独立分析师）----
DSA_AGENT_PORT=8120
TUSHARE_TOKEN=1f2efbb5be1015f9ee92da4513e9fe5eea847f9722b9a06cbaf80b26
BOCHA_API_KEY=sk-551…0810
OPENROUTER_API_KEY=sk-or-…5694
DSA_PRIMARY_MODEL=xiaomi/mimo-v2.5
DSA_FALLBACK_MODEL=deepseek/deepseek-v4-flash

# ---- 每日分析定时任务（Asia/Shanghai 时区）----
DAILY_ANALYSIS_CRON_HOUR=9
DAILY_ANALYSIS_CRON_MINUTE=30
